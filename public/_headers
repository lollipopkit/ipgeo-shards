# Cache-Control and CORS for everything served here.
#
# The paths are versioned (`v1/...`) and a month's build is never edited in
# place, so a shard can be treated as immutable for as long as a client cares
# to keep it. `immutable` is what stops a browser or a proxy revalidating a
# file that cannot have changed.
#
# `index.json` is the exception: it is what says which month is current, so it
# has to be re-read. An hour, not a day — a client that has just been told
# about a new build should not wait until tomorrow for the shards to match it.

/v1/index.json
  Cache-Control: public, max-age=3600, must-revalidate
  Access-Control-Allow-Origin: *

/v1/ip4/*
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *

/country_v1.bin
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *

/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
